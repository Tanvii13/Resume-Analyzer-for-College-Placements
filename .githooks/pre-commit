#!/bin/sh
# Git pre-commit hook to verify code quality before committing
# Run manually or automatically via: git commit

echo "🔍 Running pre-commit checks..."

# Check if ruff is available
if command -v ruff >/dev/null 2>&1; then
    RUFF_CMD="ruff"
elif [ -f "./backend/.venv/Scripts/ruff.exe" ]; then
    RUFF_CMD="./backend/.venv/Scripts/ruff.exe"
elif [ -f "./backend/.venv/bin/ruff" ]; then
    RUFF_CMD="./backend/.venv/bin/ruff"
else
    echo "⚠️  Ruff not found. Skipping lint check. Install with: pip install ruff"
    RUFF_CMD=""
fi

if [ -n "$RUFF_CMD" ]; then
    echo "⚡ Checking backend and frontend with Ruff..."
    $RUFF_CMD check backend frontend
    if [ $? -ne 0 ]; then
        echo "❌ Pre-commit check failed! Fix the Ruff lint errors above before committing."
        echo "💡 Tip: Run 'ruff check --fix backend frontend' to auto-fix safe issues,"
        echo "   or run 'git commit --no-verify' only if you must bypass this check."
        exit 1
    fi
    echo "✅ Ruff checks passed!"
fi

echo "✅ All pre-commit checks passed successfully!"
exit 0
