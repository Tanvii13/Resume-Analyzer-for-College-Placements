    USERS {
        uuid id PK
        varchar full_name
        varchar email UK
        text password_hash
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }
    ROLES {
        smallint id PK
        varchar name UK
    }
    USER_ROLES {
        uuid user_id PK, FK
        smallint role_id PK, FK
    }
    RESUMES {
        uuid id PK
        uuid user_id FK
        varchar original_filename
        text storage_key UK
        varchar file_type
        bigint file_size_bytes
        varchar status
        text error_message
        timestamptz uploaded_at
        timestamptz processed_at
    }
    RESUME_SECTIONS {
        uuid id PK
        uuid resume_id FK
        varchar section_name
        text content
        timestamptz created_at
    }
    SKILLS {
        uuid id PK
        varchar name UK
        timestamptz created_at
    }
    RESUME_SKILLS {
        uuid resume_id PK, FK
        uuid skill_id PK, FK
        varchar source
        numeric confidence
        timestamptz created_at
    }
    RESUME_ANALYSES {
        uuid id PK
        uuid resume_id FK
        varchar status
        numeric overall_score
        numeric skills_score
        numeric projects_score
        numeric education_score
        numeric experience_score
        numeric formatting_score
        numeric placement_readiness_score
        text strengths
        text weaknesses
        text recommendations
        text error_message
        timestamptz started_at
        timestamptz completed_at
    }
    ANALYSIS_FEEDBACK {
        uuid id PK
        uuid analysis_id FK
        varchar category
        varchar severity
        varchar title
        text description
        timestamptz created_at
    }
    IMPROVEMENT_SUGGESTIONS {
        uuid id PK
        uuid feedback_id FK
        text suggestion_text
        varchar priority
        timestamptz created_at
    }
    SCORE_EXPLANATIONS {
        uuid id PK
        uuid analysis_id FK
        varchar score_category
        numeric score
        text explanation
        timestamptz created_at
    }
    JOB_OPPORTUNITIES {
        uuid id PK
        varchar title
        varchar company
        varchar type
        text description_text
        varchar location
        varchar experience_level
        boolean is_active
        timestamptz posted_at
        timestamptz expires_at
    }
    JOB_DESCRIPTION_SKILLS {
        uuid id PK
        uuid job_id FK
        uuid skill_id FK
        varchar importance
        timestamptz created_at
    }
    RESUME_JD_COMPARISONS {
        uuid id PK
        uuid resume_id FK
        uuid job_id FK
        numeric overall_match_score
        numeric required_skills_match_score
        varchar status
        text error_message
        timestamptz compared_at
        timestamptz completed_at
    }
    JD_SKILL_MATCHES {
        uuid id PK
        uuid comparison_id FK
        uuid skill_id FK
        boolean is_matched
        varchar importance
        numeric match_confidence
        varchar match_note
        timestamptz created_at
    }
    RESUME_JOB_RECOMMENDATIONS {
        uuid id PK
        uuid resume_id FK
        uuid job_id FK
        smallint rank
        numeric relevance_score
        timestamptz generated_at
    }
