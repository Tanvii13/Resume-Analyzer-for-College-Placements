erDiagram
    USERS ||--o{ USER_ROLES : has
    ROLES ||--o{ USER_ROLES : assigned
    USERS ||--o{ RESUMES : uploads
    RESUMES ||--o{ RESUME_SECTIONS : contains

    USERS {
        uuid id PK
        varchar full_name
        varchar email UK
        text password_hash
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }
    ROLES {
        smallint id PK
        varchar name UK
    }
    USER_ROLES {
        uuid user_id PK, FK
        smallint role_id PK, FK
    }
    RESUMES {
        uuid id PK
        uuid user_id FK
        varchar original_filename
        text storage_key UK
        varchar file_type
        bigint file_size_bytes
        varchar status
        text error_message
        timestamptz uploaded_at
        timestamptz processed_at
    }
    RESUME_SECTIONS {
        uuid id PK
        uuid resume_id FK
        varchar section_name
        text content
        timestamptz created_at
    }
