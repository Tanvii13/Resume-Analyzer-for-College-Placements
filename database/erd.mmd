
erDiagram
    USERS ||--o{ USER_ROLES : has
    ROLES ||--o{ USER_ROLES : assigned
    USERS ||--o{ RESUMES : uploads
    RESUMES ||--o{ RESUME_SECTIONS : contains
    RESUMES ||--o{ RESUME_SKILLS : has
    RESUMES ||--o{ RESUME_ANALYSES : analyzed_by
    SKILLS ||--o{ RESUME_SKILLS : tagged_in
    RESUME_ANALYSES ||--o{ ANALYSIS_FEEDBACK : produces
    ANALYSIS_FEEDBACK ||--o{ IMPROVEMENT_SUGGESTIONS : contains
    RESUME_ANALYSES ||--o{ SCORE_EXPLANATIONS : explains

    USERS {
        uuid id PK
        varchar full_name
        varchar email UK
        text password_hash
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }

    ROLES {
        smallint id PK
        varchar name UK
    }

    USER_ROLES {
        uuid user_id PK, FK
        smallint role_id PK, FK
    }

    RESUMES {
        uuid id PK
        uuid user_id FK
        varchar original_filename
        text storage_key UK
        varchar file_type
        bigint file_size_bytes
        varchar status
        text error_message
        timestamptz uploaded_at
        timestamptz processed_at
    }

    RESUME_SECTIONS {
        uuid id PK
        uuid resume_id FK
        varchar section_name
        text content
        timestamptz created_at
    }

    SKILLS {
        uuid id PK
        varchar name UK
        timestamptz created_at
    }

    RESUME_SKILLS {
        uuid resume_id PK, FK
        uuid skill_id PK, FK
        varchar source
        numeric confidence
        timestamptz created_at
    }

    RESUME_ANALYSES {
        uuid id PK
        uuid resume_id FK
        varchar status
        numeric overall_score
        numeric skills_score
        numeric projects_score
        numeric education_score
        numeric experience_score
        numeric formatting_score
        numeric placement_readiness_score
        text strengths
        text weaknesses
        text recommendations
        text error_message
        timestamptz started_at
        timestamptz completed_at
    }

    ANALYSIS_FEEDBACK {
        uuid id PK
        uuid analysis_id FK
        varchar category
        varchar severity
        varchar title
        text description
        timestamptz created_at
    }

    IMPROVEMENT_SUGGESTIONS {
        uuid id PK
        uuid feedback_id FK
        text suggestion_text
        varchar priority
        timestamptz created_at
    }

    SCORE_EXPLANATIONS {
        uuid id PK
        uuid analysis_id FK
        varchar score_category
        numeric score
        text explanation
        timestamptz created_at
    }
